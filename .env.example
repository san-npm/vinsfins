# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Blob (existing)
BLOB_READ_WRITE_TOKEN=

# Vercel KV (Redis — atomic stock management)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin
ADMIN_PASSWORD=
TOKEN_SECRET=

# Email (Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=Vins Fins <commandes@vinsfins.lu>
ADMIN_EMAIL=info@vinsfins.lu

# Site URL (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://vinsfins.vercel.app

# DPD Web Parcel (Packlink PRO tenant DPDBBEUN)
# Created in the Web Parcel portal. Leave blank to keep booking parcels by hand:
# every DPD call is skipped when this is unset.
DPD_API_KEY=
# Sender details on the DPD label. Only the phone has no sensible default.
DPD_SENDER_PHONE=
DPD_SENDER_NAME=Vins Fins
DPD_SENDER_STREET=18 Rue Münster
DPD_SENDER_ZIP=2160
DPD_SENDER_CITY=Luxembourg
DPD_SENDER_EMAIL=contact@vinsfins.lu
# Lets Vercel Cron call /api/admin/dpd/sync to email tracking numbers (daily).
CRON_SECRET=
